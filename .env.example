# MDocs 配置示例
#
# 复制为 .env 后按需修改；.env 已被 git 忽略。
#   cp .env.example .env
#   openssl rand -hex 32   # 生成 APP_JWT__SECRET
#
# 所有变量都可以用环境变量覆盖；这里只是可复制的默认值。

# ---- 服务 ----
APP_LISTEN=0.0.0.0:8080
APP_DATA_DIR=./data

# 数据库：不设置时默认使用 SQLite（${APP_DATA_DIR}/app.db）
# SQLite 示例：
# APP_DATABASE__URL=sqlite://./data/app.db?mode=rwc
# PostgreSQL 示例：
# APP_DATABASE__URL=postgresql://mdoc:mdoc@127.0.0.1:5432/mdoc

# 必填：JWT 签名密钥（至少 32 字节随机串）
APP_JWT__SECRET=change-me-to-a-long-random-string

# ---- 上传与公开站点 ----
APP_UPLOAD__MAX_AVATAR_MB=5
# MCP 返回绝对链接时使用；留空则返回相对路径
APP_PUBLIC_BASE_URL=

# ---- MCP ----
# 反向代理 / 容器场景下额外允许的 Host（逗号分隔）
APP_MCP__ALLOWED_HOSTS=
# read_document 单次返回字节上限
APP_MCP__MAX_CONTENT_BYTES=65536
# 每分钟请求上限（按 IP + token），0 关闭
APP_MCP__RATE_LIMIT_PER_MIN=240
# 分支快照缓存保留的 head 数量
APP_MCP__SNAPSHOT_CACHE=8

# ---- 可选：向量检索 ----
# OpenAI 兼容 embeddings；留空则纯 BM25。
# Ollama 示例：
# APP_EMBEDDING__URL=http://127.0.0.1:11434/v1/embeddings
# APP_EMBEDDING__MODEL=bge-m3
APP_EMBEDDING__URL=
APP_EMBEDDING__MODEL=bge-m3
APP_EMBEDDING__API_KEY=
APP_EMBEDDING__BATCH_SIZE=16
APP_EMBEDDING__TIMEOUT_SECS=30

# ---- 日志 ----
RUST_LOG=info

# ---- Docker Compose / 构建 ----
MDOCS_PORT=8008
# APT_MIRROR=http://mirrors.aliyun.com
# NPM_REGISTRY=https://registry.npmmirror.com
# CARGO_REGISTRY_MIRROR=sparse+https://rsproxy.cn/index/
